# Staging Environment Configuration
# This file is used to build the staging deployment.
# It connects to test/staging API endpoints.
#
# ⚠️  NEVER commit this file with real secrets.
# Use GitHub repository secrets instead.

# Staging API base URL (test endpoint)
VITE_API_URL=https://staging-api.example.com/api

# Staging WebSocket endpoint (test endpoint)
VITE_WS_URL=wss://staging-api.example.com

# Mark as staging environment for telemetry/logging
# VITE_ENVIRONMENT=staging

# Optional: Feature flags for staging
# VITE_ENABLE_DEBUG_PANEL=true
# VITE_ENABLE_PERFORMANCE_METRICS=true
