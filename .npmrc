# i18next@24 declares an *optional* peer of typescript@^5, while this repo
# builds on typescript@^6. The constraint is type-definitions only, so the
# mismatch is inert at runtime — but it still makes `npm ci` abort with
# ERESOLVE, which breaks every CI job at the install step.
#
# Prefer this over forcing i18next/react-i18next major upgrades purely to
# satisfy an optional peer range. Revisit once i18next is upgraded to v26+,
# which declares `typescript: ^5 || ^6 || ^7`.
legacy-peer-deps=true
